# Configurar estos valores en hPanel. Nunca publicar credenciales en el repositorio.
NODE_ENV=production
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=REEMPLAZAR
DB_USER=REEMPLAZAR
DB_PASSWORD=REEMPLAZAR
DB_POOL_SIZE=5
# Activa SSL si tu conexión MySQL lo requiere y usa un CA válido.
DB_SSL=false
APP_URL=https://TU-DOMINIO
COOKIE_SECURE=true
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=REEMPLAZAR
# Directorio privado y persistente, fuera de public/ y del directorio que se reemplaza al desplegar.
IMPORT_PATH=/RUTA-PRIVADA-PERSISTENTE/imports
PROFILE_PHOTO_PATH=/RUTA-PRIVADA-PERSISTENTE/profile-photos
ACADEMIC_CONTENT_PATH=/RUTA-PRIVADA-PERSISTENTE/academic-content.json
AI_DAILY_REQUEST_LIMIT=20
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Primera instalación únicamente. Retirar ADMIN_PASSWORD después de crear la cuenta.
ADMIN_NAME=REEMPLAZAR
ADMIN_EMAIL=REEMPLAZAR
ADMIN_PASSWORD=REEMPLAZAR-POR-UNA-CONTRASENA-PRIVADA-DE-15-O-MAS-CARACTERES
INSTITUTION_NAME=Ruta Vocacional 360
INSTITUTION_CODE=REEMPLAZAR
