DATABASE_PATH=storage/ruta.sqlite
APP_URL=http://localhost:3000
COOKIE_SECURE=false
# Configurar true detrás de HTTPS.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Server-only Google integration. Never prefix secrets with NEXT_PUBLIC_.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Public academic content only. Student answers never leave this server.
ACADEMIC_CONTENT_PATH=storage/academic-content.json
AI_DAILY_REQUEST_LIMIT=20
PROFILE_PHOTO_PATH=storage/profile-photos
PROFILE_PHOTO_MAX_BYTES=5242880

# Only on the Vercel frontend: origin of the persistent backend (HTTPS, no path).
# Do not set API_ORIGIN on the persistent backend itself.
# API_ORIGIN=https://your-persistent-server.example
# APP_URL on the backend must match the public frontend URL.
IMPORT_PATH=storage/imports
# First administrator: use these only when running node scripts/create-admin.mjs.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
# INSTITUTION_NAME=
# INSTITUTION_CODE=
