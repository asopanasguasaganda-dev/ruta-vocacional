{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:design",
  "outputDirectory": ".design-preview/out",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/__design/publications/:path*",
      "destination": "/api/design-publications"
    }
  ]
}
